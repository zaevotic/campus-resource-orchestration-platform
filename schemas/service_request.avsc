{
  "type": "record",
  "name": "ServiceRequestEvent",
  "namespace": "campus.resource.events",
  "doc": "Emitted when a campus resource service or maintenance request is submitted or updated",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": "string", "default": "ServiceRequestCreated"},
    {"name": "correlation_id", "type": "string"},
    {"name": "timestamp", "type": "string"},
    {"name": "ticket_id", "type": "string"},
    {"name": "resource_id", "type": "string"},
    {"name": "requester_id", "type": "string"},
    {"name": "issue_type", "type": "string"},
    {"name": "description", "type": "string"},
    {"name": "priority", "type": "string", "default": "MEDIUM"},
    {"name": "status", "type": "string", "default": "OPEN"}
  ]
}
